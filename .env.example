# Copy to .env and restart: npm start (CRA only reads .env on startup)

# Backend API
REACT_APP_BACKEND_URL=https://electrovix-backend.onrender.com
# REACT_APP_BACKEND_URL=http://127.0.0.1:8000

# Google Sign-In — Web Client ID (must match backend GOOGLE_OAUTH_CLIENT_ID)
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: skip ESLint blocking local builds
# DISABLE_ESLINT_PLUGIN=true
